APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_MODE=mock
SOP_ENABLED=true
VISION_DEVICE=auto
YOLO_CONFIG_DIR=./.ultralytics
DETECTION_MODEL_PATH=
POSE_MODEL_PATH=
DETECTION_CONFIDENCE=0.40
POSE_CONFIDENCE=0.40
VLM_PROVIDER=mock
VLM_MODEL=
# OpenAI互換サーバーのAPIバージョンまで指定します（例: http://127.0.0.1:1234/v1）。
VLM_BASE_URL=
VLM_API_KEY=
VLM_INTERVAL_SECONDS=5
VLM_MAX_IMAGES=4
# キャッシュされたVLM結果がこの秒数より古い場合、vlm_confirmation条件を満たさなくなります。
VLM_MAX_RESULT_AGE_SECONDS=15.0
DATABASE_URL=sqlite:///./data/app.db
SAVE_EVENT_FRAMES=true
# 保存した証拠フレームのJPEG品質（1-100）と最大辺（px）。
FRAME_JPEG_QUALITY=80
FRAME_MAX_DIM=1280
# 証拠フレームの保存先ディレクトリ。
FRAME_STORAGE_DIR=./data/frames
# 保持期間（RETENTION_DAYS）の削除を定期実行する間隔（分）。0以下なら起動時のみ実行します。
RETENTION_INTERVAL_MINUTES=60
# サーバー側の映像取り込み: mock | camera | file | rtsp（POST /api/session/startのsource_typeが優先されます）。
SOURCE_TYPE=mock
# デバイス番号（例: "0"）、./data配下のファイルパス、またはrtsp(s)://・http(s)://のURL。
SOURCE_URI=
SOURCE_TARGET_FPS=10.0
SOURCE_QUEUE_SIZE=2
SOURCE_RECONNECT_SECONDS=3.0
# 再接続の最大試行回数。0は無制限に再試行します。
SOURCE_MAX_RECONNECT_ATTEMPTS=0
# ファイルソースを終端で最初から繰り返し再生するか。
SOURCE_LOOP_FILE=false
# 空欄なら無効。設定すると/api/*と/metricsにX-API-KeyまたはBearerトークンが必須になります（ダッシュボードはキーを送信しません）。
API_KEY=
# クライアントごとの1分あたりリクエスト数上限。0は無効。
RATE_LIMIT_PER_MINUTE=0

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_MODE=mock
SOP_ENABLED=true
VISION_DEVICE=auto
YOLO_CONFIG_DIR=./.ultralytics
DETECTION_MODEL_PATH=
POSE_MODEL_PATH=
